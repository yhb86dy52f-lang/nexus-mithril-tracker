<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NEXUS-MITHRIL - Modo OSIRIS</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body, html { width: 100%; height: 100%; background: #03060c; font-family: 'Segoe UI', system-ui, sans-serif; color: #e2e8f0; overflow: hidden; }
    #map { position: absolute; inset: 0; width: 100%; height: 100%; background: #0a1428; z-index: 1; }
    .leaflet-container { background: #0a1428; font-family: 'Segoe UI', system-ui, sans-serif; }
    .topbar { position: absolute; top: 14px; left: 16px; right: 16px; z-index: 1000; display: flex; justify-content: space-between; align-items: center; pointer-events: none; }
    .brand { display: flex; align-items: center; gap: 12px; background: rgba(10, 15, 25, 0.85); padding: 8px 16px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.08); backdrop-filter: blur(8px); }
    .brand-icon { width: 28px; height: 28px; border-radius: 50%; background: radial-gradient(circle, #facc15 30%, #ca8a04 100%); box-shadow: 0 0 12px rgba(250, 204, 21, 0.5); }
    .brand-title { font-weight: 800; letter-spacing: 2px; font-size: 14px; color: #f8fafc; }
    .brand-sub { font-size: 10px; letter-spacing: 1.5px; color: #94a3b8; }
    .telemetry-pills { display: flex; gap: 8px; }
    .pill { background: rgba(10, 15, 25, 0.85); border: 1px solid rgba(255,255,255,0.1); padding: 6px 12px; border-radius: 8px; font-size: 11px; font-weight: 700; letter-spacing: 1px; backdrop-filter: blur(8px); }
    .pill.live { color: #4ade80; border-color: rgba(74, 222, 128, 0.3); }
    .sidebar { position: absolute; top: 76px; left: 16px; bottom: 20px; width: 285px; z-index: 1000; background: rgba(11, 15, 23, 0.88); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 14px; display: flex; flex-direction: column; backdrop-filter: blur(10px); }
    .sidebar-header { font-size: 11px; font-weight: 700; letter-spacing: 1.2px; color: #94a3b8; margin-bottom: 10px; }
    .sidebar-header span { color: #4ade80; }
    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 10px; }
    .stat-box { background: rgba(255,255,255,0.04); border-radius: 8px; padding: 8px; }
    .stat-label { font-size: 9px; color: #94a3b8; letter-spacing: 0.8px; }
    .stat-val { font-size: 16px; font-weight: 800; margin-top: 2px; }
    .stat-val.green { color: #4ade80; }
    .stat-val.amber { color: #fbbf24; }
    .search-box { width: 100%; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; padding: 7px 10px; color: #f8fafc; font-size: 12px; margin-bottom: 10px; outline: none; }
    .search-box:focus { border-color: #38bdf8; }
    .unit-list { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; padding-right: 4px; }
    .unit-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; padding: 10px 12px; cursor: pointer; transition: all 0.15s ease; display: flex; justify-content: space-between; align-items: center; }
    .unit-card:hover { background: rgba(56, 189, 248, 0.12); border-color: rgba(56, 189, 248, 0.4); }
    .unit-name { font-size: 12px; font-weight: 700; color: #f1f5f9; }
    .unit-coords { font-size: 10px; color: #64748b; font-family: monospace; margin-top: 3px; }
    .badge-off { font-size: 9px; font-weight: 700; padding: 3px 6px; border-radius: 4px; background: rgba(239, 68, 68, 0.15); color: #f87171; }
    .badge-on { font-size: 9px; font-weight: 700; padding: 3px 6px; border-radius: 4px; background: rgba(74, 222, 128, 0.15); color: #4ade80; }
    .map-status { position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); z-index: 1000; background: rgba(10,15,25,0.85); border: 1px solid rgba(255,255,255,0.12); padding: 6px 12px; border-radius: 8px; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; pointer-events: none; }
    .dot { width: 13px; height: 13px; border-radius: 50%; border: 2px solid #ffffff; }
    .leaflet-popup-content-wrapper { border-radius: 10px; }
    .leaflet-popup-content { margin: 10px 12px; line-height: 1.4; }
  </style>
</head>
<body>
  <div id="map"></div>
  <div class="topbar">
    <div class="brand"><div class="brand-icon"></div><div><div class="brand-title">NEXUS-MITHRIL</div><div class="brand-sub">TRACKER PERSONAL - MODO OSIRIS (SATELITAL)</div></div></div>
    <div class="telemetry-pills"><div class="pill" id="zulu-clock">ZULU --:--:--Z</div><div class="pill" id="entity-count">ENTITIES 0</div><div class="pill live">EN VIVO</div></div>
  </div>
  <div class="sidebar">
    <div class="sidebar-header">FLOTA - <span id="online-label">0 EN LINEA</span></div>
    <div class="stats-grid">
      <div class="stat-box"><div class="stat-label">TOTAL</div><div class="stat-val" id="stat-total">0</div></div>
      <div class="stat-box"><div class="stat-label">EN LINEA</div><div class="stat-val green" id="stat-online">0</div></div>
      <div class="stat-box"><div class="stat-label">FUERA</div><div class="stat-val amber" id="stat-offline">0</div></div>
    </div>
    <input type="text" class="search-box" id="unit-search" placeholder="Filtrar unidad (ej. KW 752)..." />
    <div class="unit-list" id="unit-list"></div>
  </div>
  <div class="map-status" id="map-status">MAPA: Leaflet + Esri Satelite</div>
  <script>
    setInterval(() => { document.getElementById('zulu-clock').textContent = 'ZULU ' + new Date().toISOString().substr(11, 8) + 'Z'; }, 1000);
    if (typeof L === 'undefined') {
      document.getElementById('map-status').textContent = 'ERROR: No cargo Leaflet. Revisa tu conexion a unpkg.';
    }
    // Leaflet usa [lat, lon], al reves que el anterior que usa [lon, lat]
    const map = L.map('map', { center: [23.6, -102.5], zoom: 5, zoomControl: false, attributionControl: true }).setView([23.6, -102.5], 5);
    L.control.zoom({ position: 'bottomright' }).addTo(map);
    // Respaldo abajo, satelite arriba: si Esri falla, CARTO sigue visible
    const carto = L.tileLayer('https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png', { maxZoom: 19, attribution: 'CARTO' }).addTo(map);
    const esri = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { maxZoom: 19, attribution: 'Esri World Imagery' }).addTo(map);
    const labels = L.tileLayer('https://services.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}', { maxZoom: 19, opacity: 0.9, attribution: '' }).addTo(map);
    let esriErrores = 0;
    esri.on('tileerror', () => {
      esriErrores++;
      document.getElementById('map-status').textContent = 'MAPA: Esri con ' + esriErrores + ' errores, respaldo CARTO activo';
      if (esriErrores > 8 && map.hasLayer(esri)) { map.removeLayer(esri); document.getElementById('map-status').textContent = 'MAPA: Respaldo CARTO (Esri fallo)'; }
    });
    esri.on('load', () => { document.getElementById('map-status').textContent = 'MAPA: Leaflet + Esri Satelite'; });
    const markers = {};
    let allUnits = [];
    let firstFitDone = false;
    function extractArray(payload) {
      if (Array.isArray(payload)) return payload;
      if (!payload || typeof payload !== 'object') return [];
      for (const k of ['data', 'devices', 'units', 'vehicles', 'positions', 'items', 'fleet']) { if (Array.isArray(payload[k])) return payload[k]; }
      return [];
    }
    function normalizeUnit(u, idx) {
      const pos = u.position || u.lastPosition || u.location || u.gps || {};
      const name = u.name || u.device_name || u.unit_name || u.label || u.alias || u.imei || u.id || ('Unidad ' + (idx + 1));
      const lat = parseFloat(u.lat ?? u.latitude ?? pos.lat ?? pos.latitude ?? NaN);
      const lon = parseFloat(u.lon ?? u.lng ?? u.longitude ?? pos.lon ?? pos.lng ?? pos.longitude ?? NaN);
      const speed = parseFloat(u.speed ?? u.speed_kph ?? pos.speed ?? 0);
      const st = String(u.status ?? u.state ?? '').toLowerCase();
      const lastTs = u.last_packet_ts ?? u.last_seen ?? u.updated_at ?? 0;
      const lastMs = lastTs > 1e12 ? lastTs : lastTs * 1000;
      const ageMin = lastMs > 0 ? (Date.now() - lastMs) / 60000 : 9999;
      const isOnline = u.is_online === true || u.isOnline === true || u.online === true || u.connected === true || st === 'online' || st === 'en linea' || st === 'active' || (ageMin >= 0 && ageMin < 10);
      return { id: String(u.device_id || u.id || u.imei || name), name, lat, lon, speed, isOnline, lastPacket: lastMs };
    }
    async function loadFleet() {
      const endpoints = ['/api/hubble/devices', '/api/devices', '/api/fleet', '/api/units', '/api/positions', '/api/vehicles'];
      for (const ep of endpoints) {
        try {
          const res = await fetch(ep, { cache: 'no-store' });
          if (!res.ok) continue;
          const arr = extractArray(await res.json());
          if (arr.length > 0) { allUnits = arr.map(normalizeUnit).filter(u => !isNaN(u.lat) && !isNaN(u.lon) && (u.lat !== 0 || u.lon !== 0)); renderFleet(); return; }
        } catch (e) {}
      }
    }
    function renderFleet() {
      const query = document.getElementById('unit-search').value.trim().toLowerCase();
      const listEl = document.getElementById('unit-list');
      listEl.innerHTML = '';
      let onlineCount = 0;
      const bounds = [];
      allUnits.forEach((u) => {
        if (u.isOnline) onlineCount++;
        bounds.push([u.lat, u.lon]);
        const lastStr = u.lastPacket ? new Date(u.lastPacket).toLocaleString('es-MX') : 'sin dato';
        const popupHtml = '<div style="color:#0f172a;font-size:12px;line-height:1.4;"><strong>' + u.name + '</strong><br>Estado: <b style="color:' + (u.isOnline ? '#16a34a' : '#dc2626') + '">' + (u.isOnline ? 'EN LINEA' : 'FUERA') + '</b><br>Coord: ' + u.lat.toFixed(5) + ', ' + u.lon.toFixed(5) + '<br>Vel: ' + (isNaN(u.speed) ? 0 : Math.round(u.speed)) + ' km/h<br>Ultimo: ' + lastStr + '</div>';
        const color = u.isOnline ? '#4ade80' : '#f59e0b';
        const shadow = u.isOnline ? '0 0 10px #4ade80' : '0 0 6px rgba(0,0,0,0.9)';
        if (!markers[u.id]) {
          const icon = L.divIcon({ className: '', html: '<div class="dot" style="background:' + color + ';box-shadow:' + shadow + '"></div>', iconSize: [13, 13], iconAnchor: [6, 6] });
          markers[u.id] = L.marker([u.lat, u.lon], { icon }).bindPopup(popupHtml).addTo(map);
        } else {
          markers[u.id].setLatLng([u.lat, u.lon]);
          markers[u.id].setPopupContent(popupHtml);
          const el = markers[u.id].getElement();
          if (el) { const d = el.querySelector('.dot'); if (d) { d.style.background = color; d.style.boxShadow = shadow; } }
        }
        if (!query || u.name.toLowerCase().includes(query)) {
          const card = document.createElement('div'); card.className = 'unit-card';
          card.innerHTML = '<div><div class="unit-name">' + u.name + '</div><div class="unit-coords">' + u.lat.toFixed(4) + ', ' + u.lon.toFixed(4) + '</div></div>' + '<div class="' + (u.isOnline ? 'badge-on' : 'badge-off') + '">' + (u.isOnline ? 'EN LINEA' : 'FUERA') + '</div>';
          card.onclick = () => { map.flyTo([u.lat, u.lon], 16, { duration: 1.4 }); markers[u.id].openPopup(); };
          listEl.appendChild(card);
        }
      });
      document.getElementById('stat-total').textContent = allUnits.length;
      document.getElementById('stat-online').textContent = onlineCount;
      document.getElementById('stat-offline').textContent = allUnits.length - onlineCount;
      document.getElementById('online-label').textContent = onlineCount + ' EN LINEA';
      document.getElementById('entity-count').textContent = 'ENTITIES ' + allUnits.length;
      if (!firstFitDone && allUnits.length > 0) { firstFitDone = true; map.fitBounds(bounds, { paddingTopLeft: [320, 90], paddingBottomRight: [50, 50], maxZoom: 12 }); }
    }
    document.getElementById('unit-search').addEventListener('input', renderFleet);
    loadFleet();
    setInterval(loadFleet, 5000);
  </script>
</body>
</html>
