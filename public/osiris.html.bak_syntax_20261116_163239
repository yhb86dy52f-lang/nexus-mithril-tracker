  <script>
    // V3.2 LOCAL: Sin CDN. MapLibre se sirve desde el mismo localhost:3100 /vendor/
    // En v6 el worker era .mjs separado, en v5.7.0 es inlined/blob y NO se usa setWorkerUrl.
    // V3.4: MapLibre 5.7.0 UMD - v6 no tiene dist/maplibre-gl.js (ESM only), por eso daba 404 en los 3 CDN.
    // 5.7.0 si tiene UMD y soporta globe + terrain igual que el Osiris original.
    window.__mlSources = [
      '/vendor/maplibre-gl/maplibre-gl.js',
      '/vendor/maplibre-gl@5.7.0/maplibre-gl.js',
      '/vendor/maplibre-gl@6.7.0/maplibre-gl.js',
      '/vendor/maplibre-gl.js'
    ];
    window.__mlReady = new Promise((resolve, reject) => {
      let i = 0;
      function tryNext() {
        if (i >= window.__mlSources.length) { document.getElementById('ml-error').style.display = 'block'; document.getElementById('ml-error-msg').textContent = 'No se encontro MapLibre 5.7.0 UMD en /vendor/. Corre el script de vendor V3.3.'; reject(new Error('local vendor missing')); return; }
        const url = window.__mlSources[i++];
        console.log('[OSIRIS LOCAL 5.7.0] Intentando', url);
        const s = document.createElement('script');
        s.src = url;
        s.onload = () => {
          console.log('[OSIRIS LOCAL 5.7.0] OK desde', url, 'version:', window.maplibregl ? window.maplibregl.version : '?');
          // V3.4: En 5.x el worker es inlined/blob, NO se usa setWorkerUrl. En v6 si era .mjs separado. Si pones setWorkerUrl en v5 rompes el mapa.
          resolve();
        };
        s.onerror = () => { console.warn('[OSIRIS LOCAL 5.7.0] Fallo', url); document.getElementById('ml-error-msg').textContent = 'Fallo ' + url + ' - intentando siguiente local...'; document.getElementById('ml-error').style.display = 'block'; setTimeout(() => { document.getElementById('ml-error').style.display = 'none'; }, 1200); tryNext(); };
        document.head.appendChild(s);
      }
      tryNext();
    });
  </script>
  <script>
    // === CLON EXACTO OsirisMap.tsx 365-398 + map-projection.ts + map-terrain.ts ===
    // styleUrl = https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
    // facingLng = max(-180, min(180, -getTimezoneOffset()/4)) -> Torreon (-06:00) = -90
    // baseOptions: center [facingLng,20], zoom 1.8, minZoom 1.5, maxZoom 18, maxPitch 85
    // GLOBE_PROJECTION = {type:'globe'}
    // TERRAIN_GLOBE_PROJECTION = {type:['interpolate',['linear'],['zoom'],7,'vertical-perspective',9,'mercator']}
    // TERRAIN_MIN_ZOOM=10, DISABLE_ZOOM=9.5, SETTLE 500ms, FADE 600ms, exaggeration 0->1, maxPitch cap 60 cuando terreno activo
    setInterval(() => { document.getElementById('zulu-clock').textContent = 'ZULU ' + new Date().toISOString().substr(11, 8) + 'Z'; }, 1000);
    // Esperar a que MapLibre cargue desde cualquier CDN antes de crear el mapa
    window.__mlReady.then(() => {
    console.log('[OSIRIS 3D V3.8 DARK] MapLibre version:', maplibregl.version);
    const DARK_STYLE_URL = 'https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json';
    const DEMO_STYLE_URL = 'https://demotiles.maplibre.org/style.json';
    // V3.5: CARTO dark-matter ahora da 403 en glyphs/tiles sin API key en muchos entornos, deja el mapa negro aunque el JS cargue.
    const ESRI_URL = 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}';
    const facingLng = Math.max(-180, Math.min(180, -new Date().getTimezoneOffset() / 4));
    console.log('[OSIRIS 3D V3.8 DARK] facingLng (timezone):', facingLng, 'center:', [facingLng, 20], 'zoom: 1.8');
    let currentProjectionMode = 'globe'; // globe | mercator
    let currentStyle = 'dark'; // V3.8: CSP ya permite CARTO, oscuro por defecto, OSM es fallback
    let terrainEnabled = false; // RELIEVE 3D toggle, por defecto OFF como en page.tsx (activeLayers.terrain_elevation)
    let terrainActive = false;
    let terrainStatus = 'idle';
    let activationTimer = null;
    let fadeFrame = null;
    const TERRAIN_SOURCE = 'osiris-terrain-dem';
    const TERRAIN_MIN_ZOOM = 10;
    const DISABLE_ZOOM = 9.5;
    const TERRAIN_SETTLE_MS = 500;
    const TERRAIN_FADE_MS = 600;
    function setTerrainStatus(s) { terrainStatus = s; document.getElementById('terrain-status').textContent = s; console.log('[OSIRIS TERRAIN]', s, 'zoom:', map.getZoom().toFixed(1)); }
    function getTerrainProjection() {
      // map-projection.ts applyMapProjection
      if (currentProjectionMode === 'mercator') return { type: 'mercator' };
      if (terrainEnabled) return { type: ['interpolate', ['linear'], ['zoom'], 7, 'vertical-perspective', 9, 'mercator'] };
      return { type: 'globe' };
    }
    function applyProjection() {
      try { if (!map.isStyleLoaded()) { console.log('[OSIRIS] applyProjection diferido, style aun no cargado'); map.once('style.load', () => { try { map.setProjection(getTerrainProjection()); } catch(e){} }); return; } map.setProjection(getTerrainProjection()); } catch (e) { console.log('setProjection fallo', e); }
      // Cuando cambia proyeccion, re-evaluar terreno
      updateTerrain();
    }
    function fadeTerrain(to, done) {
      if (fadeFrame) cancelAnimationFrame(fadeFrame);
      const terrain = map.getTerrain();
      const from = terrain ? terrain.exaggeration : to;
      if (!terrain || from === to) { if (done) done(); return; }
      let start;
      const step = (now) => {
        start = start || now;
        const t = Math.min(1, (now - start) / (TERRAIN_FADE_MS * Math.abs(to - from)));
        terrain.exaggeration = from + (to - from) * t * t * (3 - 2 * t);
        map.triggerRepaint();
        if (t < 1) fadeFrame = requestAnimationFrame(step);
        else { fadeFrame = undefined; if (done) done(); }
      };
      fadeFrame = requestAnimationFrame(step);
    }
    function releaseTerrain() {
      terrainActive = false;
      if (fadeFrame) cancelAnimationFrame(fadeFrame);
      try { if (map.getTerrain() && map.getTerrain().source === TERRAIN_SOURCE) map.setTerrain(null); } catch(e) {}
      try { if (map.getSource(TERRAIN_SOURCE)) map.removeSource(TERRAIN_SOURCE); } catch(e) {}
      // Restaurar maxPitch original 85 cuando terreno se apaga
      try { map.setMaxPitch(85); } catch(e) {}
    }
    function activateTerrain() {
      activationTimer = null;
      if (!terrainEnabled || terrainActive || map.isMoving() || document.hidden || map.getZoom() < TERRAIN_MIN_ZOOM) return;
      terrainActive = true;
      setTerrainStatus('loading');
      try {
        map.addSource(TERRAIN_SOURCE, { type: 'raster-dem', tiles: ['https://demotiles.maplibre.org/terrain-tiles/{z}/{x}/{y}.png'], encoding: 'terrarium', tileSize: 256, maxzoom: 10, attribution: 'Terrain data credits' }); // V3.8: CSP ya permite demotiles
        try { map.setSourceTileLodParams(10, 1.25, TERRAIN_SOURCE); } catch(e) {}
        // Cap pitch a 60 como map-terrain.ts
        try { map.setMaxPitch(60); } catch(e) {}
        map.setTerrain({ source: TERRAIN_SOURCE, exaggeration: 1 });
        map.getTerrain().exaggeration = 0; // plano hasta que cargue, luego fade
      } catch (e) { console.warn('[OSIRIS] Terrain unavailable:', e); releaseTerrain(); setTerrainStatus('error'); }
    }
    function updateTerrain() {
      if (!terrainEnabled) { if (terrainActive) { releaseTerrain(); } setTerrainStatus('idle'); return; }
      if (terrainActive) return;
      if (activationTimer) clearTimeout(activationTimer);
      if (map.getZoom() < TERRAIN_MIN_ZOOM) { setTerrainStatus('idle'); return; }
      setTerrainStatus('waiting');
      if (!map.isMoving() && !document.hidden) activationTimer = setTimeout(activateTerrain, TERRAIN_SETTLE_MS);
    }
    function onZoomTerrain() {
      if (!terrainActive && map.getZoom() < TERRAIN_MIN_ZOOM) { if (activationTimer) clearTimeout(activationTimer); if (terrainEnabled) setTerrainStatus('idle'); }
      if (terrainActive && map.getZoom() < DISABLE_ZOOM) { releaseTerrain(); setTerrainStatus('idle'); }
    }
    function onDataTerrain(e) {
      if (terrainActive && e.sourceId === TERRAIN_SOURCE && e.isSourceLoaded && (e.tile || e.sourceDataType === 'idle')) {
        setTerrainStatus('ready');
        // Fade 0 -> 1 una sola vez
        if (map.getTerrain() && map.getTerrain().exaggeration === 0) fadeTerrain(1);
      }
    }
    // === V3.6 DIAGNOSTICO WebGL + RASTER por defecto ===
    // V3.5 siguio negro con CARTO y con demotiles (ambos vector). Leaflet si pintaba Esri porque usa Canvas 2D, no WebGL.
    // Si WebGL esta bloqueado, ni el vector ni el raster de MapLibre pintan. Este diagnostico lo muestra en pantalla.
    (function(){
      const c = document.createElement('canvas');
      const gl2 = c.getContext('webgl2');
      const gl1 = !gl2 && c.getContext('webgl');
      const glExp = !gl2 && !gl1 && c.getContext('experimental-webgl');
      const ok = !!(gl2 || gl1 || glExp);
      const d = document.createElement('div');
      d.id = 'osiris-diag';
      d.style.cssText = 'position:absolute;top:14px;right:16px;z-index:99;background:rgba(0,0,0,0.82);border:1px solid #38bdf8;border-radius:10px;padding:10px 12px;font-size:11px;line-height:1.6;color:#e2e8f0;max-width:280px;font-family:monospace;';
      d.innerHTML = '<b style="color:#38bdf8;">DIAG V3.8 CSP FIX</b><br>WebGL2: ' + (gl2 ? 'OK' : 'FAIL') + ' | WebGL1: ' + (gl1||glExp ? 'OK' : 'FAIL') + '<br><span id="diag-style">Style: esperando...</span><br><span id="diag-err">Error: ninguno</span><br><span style="color:#94a3b8;">CSP parcheado, CARTO/Esri/demotiles permitidos. V3.8 oscuro por defecto, OSM fallback.</span>';
      document.body.appendChild(d);
      window.__osirisWebGL = ok;
      console.log('[OSIRIS 3D V3.8] WebGL2:', !!gl2, 'WebGL1:', !!(gl1||glExp));
    })();
    function diagStyle(txt){ const el=document.getElementById('diag-style'); if(el) el.textContent='Style: '+txt; }
    function diagErr(txt){ const el=document.getElementById('diag-err'); if(el) el.textContent='Error: '+txt; }
    // Estilo raster OSM por defecto - unico host permitido por CSP
    // V3.7 CSP FIX: CSP connect-src 'self' + ntfy + unpkg + *.tile.openstreetmap.org - CARTO, demotiles y Esri BLOQUEADOS -> Failed to fetch (0). Solo OSM permitido.
    const OSM_RASTER_STYLE = { version: 8, sources: { 'osm': { type: 'raster', tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'], tileSize: 256, attribution: '© OpenStreetMap contributors' } }, layers: [ { id: 'background', type: 'background', paint: { 'background-color': '#020408' } }, { id: 'osm-base', type: 'raster', source: 'osm', minzoom: 0, maxzoom: 19 } ] };
    const ESRI_RASTER_STYLE = OSM_RASTER_STYLE;
    // === CREACION MAPA con fallback WebGL como OsirisMap 400-425 ===
    const baseOptions = {
      container: 'map', style: DARK_STYLE_URL,
      center: [facingLng, 20], zoom: 1.8, minZoom: 1.5, maxZoom: 18,
      attributionControl: { compact: true, customAttribution: 'Places: <a href="https://www.wikipedia.org/" target="_blank" rel="noopener noreferrer">Wikipedia</a>, <a href="https://www.wikidata.org/" target="_blank" rel="noopener noreferrer">Wikidata</a>, <a href="https://www.geonames.org/" target="_blank" rel="noopener noreferrer">GeoNames</a> (CC BY 4.0)' },
      maxPitch: 85, antialias: true, projection: { type: 'globe' }
    };
    const attributeFallbacks = [ undefined, { powerPreference: 'low-power', failIfMajorPerformanceCaveat: false }, { powerPreference: 'low-power', failIfMajorPerformanceCaveat: false, antialias: false } ];
    let map = null;
    for (const attrs of attributeFallbacks) {
      try { map = new maplibregl.Map(attrs ? { ...baseOptions, canvasContextAttributes: attrs } : baseOptions); break; } catch (e) { document.getElementById('map').innerHTML = ''; console.warn('[OSIRIS] WebGL context rejected, retrying:', e.message); if (attrs === attributeFallbacks[attributeFallbacks.length-1]) throw e; }
    }
    let styleFallbackDone = false;
    let styleFallbackTimer = null;
    function fallbackToDemo(reason) {
      if (styleFallbackDone) return;
      styleFallbackDone = true;
      console.log('[OSIRIS 3D V3.8] Fallback a demotiles por:', reason);
      currentStyle = 'demo';
      try { map.setStyle(OSM_RASTER_STYLE); // V3.7: demotiles tambien bloqueado por CSP, fallback a OSM inline map.once('style.load', () => { applyProjection(); console.log('[OSIRIS 3D V3.8] Estilo demotiles cargado, si ahora ves el globo, CARTO era el que fallaba'); }); } catch(e) { console.log('fallbackToDemo fallo', e); }
    }
    map.on('error', (e) => { const msg = e && e.error ? e.error.message : String(e); console.log('[OSIRIS 3D V3 MAP ERROR]', msg); diagErr(msg); if (/style|glyph|sprite|Failed to load|403|404|CORS|basemaps\.cartocdn/i.test(msg)) fallbackToDemo(msg); });
    styleFallbackTimer = setTimeout(() => { if (!map.isStyleLoaded()) fallbackToDemo('timeout 8s style no cargado'); }, 8000);
    map.on('movestart', () => { if (activationTimer) clearTimeout(activationTimer); });
    map.on('zoom', onZoomTerrain);
    map.on('moveend', updateTerrain);
    map.on('sourcedata', onDataTerrain);
    map.on('load', () => {
      if (styleFallbackTimer) clearTimeout(styleFallbackTimer);
      console.log('[OSIRIS 3D V3.8 DARK] Mapa cargado, proyeccion:', map.getProjection() ? JSON.stringify(map.getProjection().type) : 'n/a', 'style:', currentStyle);
      map.resize();
      applyProjection();
    });
    // V3.6: Si en 10s sigue sin cargar, probar mercator 2D - si globo esta roto, 2D si pinta
    setTimeout(() => { try { if (!map.isStyleLoaded()) { console.log('[OSIRIS 3D V3.8] 10s sin style, probando mercator 2D'); currentProjectionMode='mercator'; applyProjection(); diagStyle('forzando mercator 2D'); } } catch(e){} }, 10000);
    map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'bottom-right');
    // V3.7: GlobeControl quitado - llamaba setProjection sin verificar isStyleLoaded y daba 'Style is not done loading'.
    function satStyleObj() {
      return { version: 8, projection: getTerrainProjection(), sources: { 'sat-imagery': { type: 'raster', tiles: [ESRI_URL] // V3.8: CSP ya permite Esri, tileSize: 256, attribution: 'Esri World Imagery' }, 'sat-labels': { type: 'raster', tiles: ['https://services.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}'], tileSize: 256 } }, sky: { 'sky-color': '#7fb2e8', 'horizon-color': '#d8e8ff', 'fog-color': '#c8d8f0', 'fog-ground-blend': 0.6, 'horizon-fog-blend': 0.5, 'sky-horizon-blend': 0.5, 'atmosphere-blend': 0.6 }, light: { anchor: 'map', color: '#ffffff', intensity: 0.55, position: [1.5, 90, 80] }, layers: [ { id: 'background', type: 'background', paint: { 'background-color': '#020408' } }, { id: 'sat-base', type: 'raster', source: 'sat-imagery', minzoom: 0, maxzoom: 22 }, { id: 'sat-ref', type: 'raster', source: 'sat-labels', minzoom: 0, maxzoom: 22 } ] };
    }
    function setStyleDark() {
      styleFallbackDone = false;
      currentStyle = 'dark';
      document.getElementById('btn-map').classList.add('active'); document.getElementById('btn-sat').classList.remove('active');
      // Al cambiar style se pierde terrain, hay que re-activar
      terrainActive = false;
      map.setStyle(DARK_STYLE_URL); // V3.8: CSP ya permite CARTO
      map.once('style.load', () => { applyProjection(); });
    }
    function setStyleSat() {
      currentStyle = 'satellite';
      document.getElementById('btn-sat').classList.add('active'); document.getElementById('btn-map').classList.remove('active');
      terrainActive = false;
      map.setStyle(satStyleObj());
      map.once('style.load', () => { applyProjection(); });
    }
    document.getElementById('btn-map').onclick = setStyleDark;
    document.getElementById('btn-sat').onclick = setStyleSat;
    function set3D() {
      currentProjectionMode = 'globe';
      document.getElementById('btn-3d').classList.add('active'); document.getElementById('btn-2d').classList.remove('active');
      applyProjection();
      map.easeTo({ pitch: 0, bearing: 0, duration: 1000 });
    }
    function set2D() {
      currentProjectionMode = 'mercator';
      document.getElementById('btn-2d').classList.add('active'); document.getElementById('btn-3d').classList.remove('active');
      applyProjection();
      map.easeTo({ pitch: 0, bearing: 0, duration: 1000 });
    }
    document.getElementById('btn-3d').onclick = set3D;
    document.getElementById('btn-2d').onclick = set2D;
    document.getElementById('btn-relieve').onclick = (ev) => {
      terrainEnabled = !terrainEnabled; ev.target.classList.toggle('active', terrainEnabled);
      console.log('[OSIRIS] terrainEnabled:', terrainEnabled);
      applyProjection();
      if (terrainEnabled) {
        if (map.getZoom() < TERRAIN_MIN_ZOOM) {
          // Sugerencia del original: hay que acercar a zoom >=10 para ver relieve
          document.getElementById('terrain-status').textContent = 'acerca a zoom >=10';
          // Si hay flota, acercar a la primera unidad para mostrar relieve de inmediato
          if (allUnits.length > 0) { const u = allUnits[0]; map.flyTo({ center: [u.lon, u.lat], zoom: 12, pitch: 60, duration: 1600 }); }
        } else { map.easeTo({ pitch: 60, bearing: -12, duration: 1000 }); }
      } else {
        releaseTerrain(); setTerrainStatus('idle');
        map.easeTo({ pitch: 0, duration: 800 });
      }
    };
    document.getElementById('btn-mexico').onclick = () => { map.flyTo({ center: [-102.5, 23.6], zoom: 5, pitch: 0, duration: 1400 }); };
    let spinning = false;
    document.getElementById('btn-spin').onclick = (ev) => { spinning = !spinning; ev.target.classList.toggle('active', spinning); if (spinning) { const spin = () => { if (!spinning) return; map.easeTo({ bearing: map.getBearing() + 0.4, duration: 100, easing: (t) => t }); setTimeout(spin, 110); }; spin(); } };
    const markers = {};
    let allUnits = [];
    let firstFitDone = false;
    function extractArray(payload) { if (Array.isArray(payload)) return payload; if (!payload || typeof payload !== 'object') return []; for (const k of ['data', 'devices', 'units', 'vehicles', 'positions', 'items', 'fleet']) { if (Array.isArray(payload[k])) return payload[k]; } return []; }
    function normalizeUnit(u, idx) {
      const pos = u.position || u.lastPosition || u.location || u.gps || {};
      const name = u.name || u.device_name || u.unit_name || u.label || u.alias || u.imei || u.id || ('Unidad ' + (idx + 1));
      const lat = parseFloat(u.lat ?? u.latitude ?? pos.lat ?? pos.latitude ?? NaN);
      const lon = parseFloat(u.lon ?? u.lng ?? u.longitude ?? pos.lon ?? pos.lng ?? pos.longitude ?? NaN);
      const speed = parseFloat(u.speed ?? u.speed_kph ?? pos.speed ?? 0);
      const st = String(u.status ?? u.state ?? '').toLowerCase();
      const lastTs = u.last_packet_ts ?? u.last_seen ?? u.updated_at ?? 0;
      const lastMs = lastTs > 1e12 ? lastTs : lastTs * 1000;
      const ageMin = lastMs > 0 ? (Date.now() - lastMs) / 60000 : 9999;
      const isOnline = u.is_online === true || u.isOnline === true || u.online === true || u.connected === true || st === 'online' || st === 'en linea' || st === 'active' || (ageMin >= 0 && ageMin < 10);
      return { id: String(u.device_id || u.id || u.imei || name), name, lat, lon, speed, isOnline, lastPacket: lastMs };
    }
    async function loadFleet() {
      const endpoints = ['/api/hubble/devices', '/api/devices', '/api/fleet', '/api/units', '/api/positions', '/api/vehicles'];
      for (const ep of endpoints) {
        try { const res = await fetch(ep, { cache: 'no-store' }); if (!res.ok) continue; const arr = extractArray(await res.json()); if (arr.length > 0) { allUnits = arr.map(normalizeUnit).filter(u => !isNaN(u.lat) && !isNaN(u.lon) && (u.lat !== 0 || u.lon !== 0)); renderFleet(); return; } } catch (e) {}
      }
    }
    function renderFleet() {
      const query = document.getElementById('unit-search').value.trim().toLowerCase();
      const listEl = document.getElementById('unit-list'); listEl.innerHTML = '';
      let onlineCount = 0; const bounds = new maplibregl.LngLatBounds();
      allUnits.forEach((u) => {
        if (u.isOnline) onlineCount++; bounds.extend([u.lon, u.lat]);
        const lastStr = u.lastPacket ? new Date(u.lastPacket).toLocaleString('es-MX') : 'sin dato';
        const popupHtml = '<div style="color:#0f172a;font-size:12px;line-height:1.4;"><strong>' + u.name + '</strong><br>Estado: <b style="color:' + (u.isOnline ? '#16a34a' : '#dc2626') + '">' + (u.isOnline ? 'EN LINEA' : 'FUERA') + '</b><br>Coord: ' + u.lat.toFixed(5) + ', ' + u.lon.toFixed(5) + '<br>Vel: ' + (isNaN(u.speed) ? 0 : Math.round(u.speed)) + ' km/h<br>Ultimo: ' + lastStr + '</div>';
        if (map && map.loaded && map.loaded() && !markers[u.id]) {
          const el = document.createElement('div'); el.style.width = '14px'; el.style.height = '14px'; el.style.borderRadius = '50%'; el.style.backgroundColor = u.isOnline ? '#4ade80' : '#f59e0b'; el.style.border = '2px solid #ffffff'; el.style.boxShadow = u.isOnline ? '0 0 12px #4ade80' : '0 0 6px rgba(0,0,0,0.9)'; el.style.cursor = 'pointer';
          markers[u.id] = new maplibregl.Marker({ element: el }).setLngLat([u.lon, u.lat]).setPopup(new maplibregl.Popup({ offset: 14 }).setHTML(popupHtml)).addTo(map);
        } else if (map && map.loaded && map.loaded() && markers[u.id]) { markers[u.id].setLngLat([u.lon, u.lat]); markers[u.id].getPopup().setHTML(popupHtml); markers[u.id].getElement().style.backgroundColor = u.isOnline ? '#4ade80' : '#f59e0b'; }
        if (!query || u.name.toLowerCase().includes(query)) {
          const card = document.createElement('div'); card.className = 'unit-card'; card.innerHTML = '<div><div class="unit-name">' + u.name + '</div><div class="unit-coords">' + u.lat.toFixed(4) + ', ' + u.lon.toFixed(4) + '</div></div>' + '<div class="' + (u.isOnline ? 'badge-on' : 'badge-off') + '">' + (u.isOnline ? 'EN LINEA' : 'FUERA') + '</div>';
          card.onclick = () => { map.flyTo({ center: [u.lon, u.lat], zoom: 14, pitch: terrainEnabled ? 60 : 0, duration: 1400 }); try { if (markers[u.id] && markers[u.id].togglePopup) markers[u.id].togglePopup(); } catch(e){ console.log('togglePopup guardado', e.message); } };
          listEl.appendChild(card);
        }
      });
      document.getElementById('stat-total').textContent = allUnits.length;
      document.getElementById('stat-online').textContent = onlineCount;
      document.getElementById('stat-offline').textContent = allUnits.length - onlineCount;
      document.getElementById('online-label').textContent = onlineCount + ' EN LINEA';
      document.getElementById('entity-count').textContent = 'ENTITIES ' + allUnits.length;
      if (!firstFitDone && allUnits.length > 0 && map && map.loaded && map.loaded()) { firstFitDone = true; setTimeout(() => { map.fitBounds(bounds, { padding: { top: 90, bottom: 60, left: 320, right: 50 }, maxZoom: 10, duration: 1800 }); }, 800); }
    }
    document.getElementById('unit-search').addEventListener('input', renderFleet);
    map.on('load', () => { loadFleet(); });
    // Flota desacoplada: si el mapa falla, la lista igual carga (fix captura: ENTITIES 0 porque loadFleet dependia de map load)
    loadFleet();
    setInterval(loadFleet, 5000);
    }).catch(e => { console.error('[OSIRIS] MapLibre no cargó', e); loadFleet(); setInterval(loadFleet, 5000); });
  </script>
</body>
</html>
