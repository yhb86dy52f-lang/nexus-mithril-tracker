<body>
  <div id="map"></div>
  <div class="topbar">
    <div class="brand"><div class="brand-icon"></div><div><div class="brand-title">NEXUS-MITHRIL</div><div class="brand-sub">TRACKER PERSONAL - MODO OSIRIS (3D GLOBO V3.8 DARK CSP FIX)</div></div></div>
    <div class="telemetry-pills"><div class="pill" id="zulu-clock">ZULU --:--:--Z</div><div class="pill" id="entity-count">ENTITIES 0</div><div class="pill live">EN VIVO</div></div>
