"use strict";
const fs = require("fs");
const path = require("path");
const peg = require("pegjs");
const Ajv = require("ajv");
const addFormats = require("ajv-formats");
const schemaPath = path.join(__dirname, "telemetry_schema.json");
const schema = JSON.parse(fs.readFileSync(schemaPath, "utf8"));
const GRAMMAR = `
Message
  = CTFrame / KWFrame / R0Frame
CTFrame
  = "E" esn:ESN "FFFF" payload:Payload {
      return { family: "CT", esn, rawPayload: payload };
    }
KWFrame
  = "KW," esn:ESN "," "rssi=" rssi:SignedInt rest:KWRest? {
      return { family: "KW", esn, rssi, rest: rest || {} };
    }
KWRest
  = "," "bat=" bat:Float "," "ign=" ign:("0" / "1") {
      return { battery_v: bat, ignition: ign === "1" };
    }
R0Frame
  = "R0," esn:ESN "," "GPS:" lat:Float "," lon:Float "," speed:Float "," heading:Integer {
      return { family: "R0", esn, lat, lon, speed_kmh: speed, heading };
    }
ESN
  = digits:[0-9]{10} { return digits.join(""); }
Payload
  = pairs:([0-9A-Fa-f][0-9A-Fa-f])+ {
      return pairs.map(function(p) { return p.join(""); }).join("");
    }
SignedInt
  = sign:"-"? digits:[0-9]+ {
      return parseInt((sign || "") + digits.join(""), 10);
    }
Integer
  = digits:[0-9]+ { return parseInt(digits.join(""), 10); }
Float
  = sign:"-"? int:[0-9]+ "." frac:[0-9]+ {
      return parseFloat((sign || "") + int.join("") + "." + frac.join(""));
    }
  / SignedInt
`;
const parser = peg.generate(GRAMMAR, { allowedStartRules: ["Message"] });
const ajv = new Ajv({ allErrors: true, strict: true });
addFormats(ajv);
const validate = ajv.compile(schema);
function decodeCTPayload(hex) {
  const tempRaw = parseInt(hex.slice(0, 4), 16);
  const humidity = parseInt(hex.slice(4, 6), 16);
  const flags = hex.length >= 8 ? parseInt(hex.slice(6, 8), 16) : 0;
  const batteryRaw = hex.length >= 10 ? parseInt(hex.slice(8, 10), 16) : null;
  return {
    temp_c: tempRaw / 10 - 40,
    humidity_pct: humidity,
    door_open: (flags & 1) === 1,
    battery_v: batteryRaw === null ? null : batteryRaw / 10,
    payload_hex: hex
  };
}
const builders = {
  CT: function(parsed) { return { gps: null, ct_data: decodeCTPayload(parsed.rawPayload), kw_data: null }; },
  KW: function(parsed) { return { gps: null, ct_data: null, kw_data: { rssi_dbm: parsed.rssi, battery_v: parsed.rest.battery_v !== undefined ? parsed.rest.battery_v : null, ignition: parsed.rest.ignition !== undefined ? parsed.rest.ignition : false } }; },
  R0: function(parsed) { return { gps: { lat: parsed.lat, lon: parsed.lon, speed_kmh: parsed.speed_kmh, heading: parsed.heading, fix: true }, ct_data: null, kw_data: null }; }
};
function buildNormalized(parsed, raw) {
  const builder = builders[parsed.family];
  if (builder === undefined) { throw new Error("Familia no soportada: " + parsed.family); }
  return { family: parsed.family, esn: parsed.esn, raw: raw, parsedAt: new Date().toISOString(), telemetry: builder(parsed) };
}
function parseSMS(rawString) {
  if (typeof rawString !== "string" || rawString.trim().length === 0) { throw new Error("parseSMS: rawString debe ser string no vacio"); }
  const raw = rawString.trim();
  let parsed;
  try { parsed = parser.parse(raw); } catch (e) {
    const loc = e.location ? "linea " + e.location.start.line + " columna " + e.location.start.column : "posicion desconocida";
    throw new Error("Error de gramatica en " + loc + " Entrada: " + raw);
  }
  const normalized = buildNormalized(parsed, raw);
  const ok = validate(normalized);
  if (!ok) { throw new Error("Error de esquema: " + ajv.errorsText(validate.errors)); }
  return normalized;
}
module.exports = { parseSMS, parser, validate, decodeCTPayload };