<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NEXUS-MITHRIL - Modo OSIRIS 3D</title>
<link href="/vendor/cesium/Build/Cesium/Widgets/widgets.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:#000;color:#F2F2F7;font-family:Inter,system-ui,sans-serif}
#cesiumContainer{position:absolute;inset:0}
.cesium-viewer-bottom,.cesium-viewer-toolbar{display:none !important}
.top{position:absolute;top:0;left:0;right:0;height:56px;display:flex;justify-content:space-between;align-items:center;padding:0 18px;z-index:10;background:linear-gradient(180deg,rgba(0,0,0,.78),rgba(0,0,0,.15) 85%,transparent);pointer-events:none}
.top *{pointer-events:auto}
.brand{display:flex;gap:12px;align-items:center}
.eye{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle,#FFD700,#8B6508);font-size:18px;box-shadow:0 0 18px rgba(255,215,0,.6)}
.brand b{letter-spacing:.28em;font-size:17px;color:#E8C547}
.brand span{display:block;font-size:9px;letter-spacing:.22em;color:#9A9AB0;font-weight:600}
.hud{display:flex;gap:10px;align-items:center;font-family:"JetBrains Mono",monospace;font-size:11px}
.pill{border:1px solid rgba(255,215,0,.35);background:rgba(0,0,0,.55);backdrop-filter:blur(8px);padding:6px 10px;border-radius:999px;color:#FFE98A}
.cyan{color:#22D3EE}.green{color:#00FF88}
.dock{position:absolute;left:12px;top:76px;z-index:10;display:flex;flex-direction:column;gap:8px}
.dock button{width:38px;height:38px;border-radius:12px;border:1px solid rgba(255,255,255,.14);background:rgba(10,10,18,.72);color:#fff;cursor:pointer;font-size:16px}
.dock button.active{background:#E8C547;color:#000}
.sidebar{position:absolute;left:64px;top:76px;bottom:92px;width:308px;z-index:10;background:rgba(12,12,20,.82);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.12);border-radius:16px;overflow:hidden;display:flex;flex-direction:column}
.side-head{padding:14px}
.side-head h2{font-size:11px;letter-spacing:.16em;color:#9A9AB0}
.kpis{display:flex;gap:8px;margin-top:10px}
.kpi{flex:1;background:rgba(255,255,255,.06);border-radius:10px;padding:8px}
.kpi small{color:#9A9AB0;font-size:10px}
.kpi b{display:block;font-size:18px}
.search{margin:0 14px 10px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:999px;padding:9px 12px;display:flex;gap:8px}
.search input{background:transparent;border:0;outline:0;color:#fff;width:100%;font-size:12px}
.list{overflow:auto;flex:1;padding:0 10px 10px}
.item{padding:10px;border-radius:12px;cursor:pointer;margin-bottom:8px;background:rgba(255,255,255,.04);border:1px solid transparent}
.item:hover{border-color:rgba(255,255,255,.15)}
.item.active{border-color:#00FF88;background:rgba(0,255,136,.08)}
.item-top{display:flex;justify-content:space-between;align-items:center}
.item b{font-size:12px}
.badge{font-size:10px;font-weight:800;padding:4px 7px;border-radius:999px}
.on{background:#0F3A24;color:#7CFFB2}.off{background:#3A1A1A;color:#FDA4AF}
.item small{color:#9A9AB0;font-family:"JetBrains Mono",monospace;font-size:10px;display:block;margin-top:4px}
.controls{position:absolute;left:64px;bottom:52px;z-index:10;display:flex;gap:6px;background:rgba(0,0,0,.62);border:1px solid rgba(255,255,255,.14);padding:5px;border-radius:999px}
.controls button{border:0;padding:8px 12px;border-radius:999px;background:transparent;color:#CFCFE0;cursor:pointer;font-weight:700;font-size:11px}
.controls button.active{background:#E8C547;color:#000}
.ticker{position:absolute;left:0;right:0;bottom:0;height:36px;z-index:10;background:rgba(0,0,0,.78);border-top:1px solid rgba(255,255,255,.12);display:flex;align-items:center;gap:16px;padding:0 14px;font-family:"JetBrains Mono",monospace;font-size:11px;overflow:hidden;white-space:nowrap}
.ticker b{color:#E8C547}
.marquee{display:inline-block;animation:scroll 32s linear infinite}
@keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.cursor{position:absolute;right:14px;bottom:44px;z-index:10;font-family:"JetBrains Mono",monospace;font-size:10px;color:#CFCFE0;background:rgba(0,0,0,.55);padding:6px 9px;border-radius:8px}
.hint{position:absolute;right:14px;top:76px;z-index:10;width:210px;background:rgba(0,0,0,.6);border:1px solid rgba(255,215,0,.25);border-radius:12px;padding:10px;font-size:11px;line-height:1.5;color:#D8D8E6}
.hint b{color:#E8C547}
@media(max-width:820px){.sidebar{display:none}.hint{display:none}}
</style>
</head>
<body>
<div id="cesiumContainer"></div>
<div class="top"><div class="brand"><div class="eye">O</div><div><b>NEXUS-MITHRIL</b><span>TRACKER PERSONAL - MODO OSIRIS</span></div></div><div class="hud"><div class="pill">ZULU <span class="cyan" id="zulu">--:--:--</span></div><div class="pill">ENTITIES <span class="green" id="hudCount">0</span></div><div class="pill" id="api-status">EN VIVO</div></div></div>
<div class="dock"><button class="active" title="Flota">S</button><button title="Capas">C</button><button id="btn-【entity-usgs¦canonical_name=USGS】-quakes" title="Sismos 【entity-USGS¦canonical_name=USGS】">SISMOS</button><button title="Alertas">!</button></div>
<aside class="sidebar"><div class="side-head"><h2>FLOTA - <span style="color:#00FF88" id="kpi-online">0 EN LINEA</span></h2><div class="kpis"><div class="kpi"><small>TOTAL</small><b id="kpi-total">0</b></div><div class="kpi"><small>EN LINEA</small><b style="color:#00FF88" id="kpi-online-2">0</b></div><div class="kpi"><small>FUERA</small><b style="color:#F59E0B" id="kpi-offline">0</b></div></div></div><div class="search">Buscar <input id="q" placeholder="Buscar unidad... PB705, Durango..."></div><div class="list" id="list"></div></aside>
<div class="controls"><button id="b3d" class="active">3D</button><button id="b2d">2D</button><button id="bMap">MAP</button><button id="bSat" class="active">SAT</button><button id="bArcs">ARCOS ON</button><a href="/fleet.html" style="text-decoration:none;color:#CFCFE0;padding:8px 10px;font-size:11px;font-weight:700">VOLVER A FLEET</a></div>
<div class="cursor" id="cursor">CURSOR --</div>
<div class="ticker"><b>LIVE</b><span><span class="marquee" id="marquee">M5.2 79 km WSW de Changuinola - M4.8 10 km SW de Guaymas - PB705-07 KW 752 EN LINEA - 37 UNIDADES - BTC 68.8K - &nbsp;&nbsp;M5.2 79 km WSW de Changuinola - M4.8 10 km SW de Guaymas - PB705-07 KW 752 EN LINEA - 37 UNIDADES - BTC 68.8K - &nbsp;&nbsp;</span></span></div>
<div class="hint"><b>Modo OSIRIS</b><br>CesiumJS + 【entity-Esri¦canonical_name=Esri】 Satelite. Arrastra para girar, rueda para zoom. Clic en una unidad para volar a ella. Si el backend no responde, muestra demo.</div>
<script>/* ZULU-INDEPENDIENTE */ setInterval(function(){ var el=document.getElementById("zulu"); if(el){ el.textContent=new Date().toISOString().slice(11,19)+"Z"; } },1000);</script>
<script>window.CESIUM_BASE_URL="/vendor/cesium/Build/Cesium/";</script>
<script src="/vendor/cesium/Build/Cesium/Cesium.js"></script>
<script src="/osiris-config.js"></script>
<script>
var CFG = window.OSIRIS_CONFIG || { apiPositions: '/api/positions', apiStatus: '/api/system/status', wsPath: '/ws', hubLat: 25.54, hubLon: -103.52, refreshMs: 5000, usgsUrl: 'https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson' };
var FLEET = [];
var DEMO = [
  { id: 'PB705-07 KW 752', lat: 27.545102, lon: -99.577072, on: true, city: 'Nuevo Laredo' },
  { id: 'PB705-06 KW 759', lat: 20.530707, lon: -100.454639, on: false, city: 'Queretaro' },
  { id: 'PB705-04 KW 749', lat: 25.546593, lon: -103.532026, on: false, city: 'Torreon' },
  { id: 'PB705-05 KW 750', lat: 23.794091, lon: -100.56953, on: false, city: 'Matehuala' },
  { id: 'PB705-01 KW 751', lat: 25.686, lon: -100.316, on: false, city: 'Monterrey' },
  { id: 'PB705-10 KW 757', lat: 24.027, lon: -104.653, on: false, city: 'Durango' },
  { id: 'PB705-11 KW 758', lat: 25.539, lon: -103.443, on: false, city: 'Lerdo' },
  { id: 'PB705-19 KW 767', lat: 17.065, lon: -96.725, on: false, city: 'Oaxaca' },
  { id: 'PB705-21 KW 769', lat: 36.169, lon: -115.139, on: false, city: 'Las Vegas' },
  { id: 'PB705-24 KW 772', lat: 29.76, lon: -95.369, on: false, city: 'Houston' }
];
Cesium.Ion.defaultAccessToken = undefined;
var esriImagery = new Cesium.UrlTemplateImageryProvider({ url: 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', credit: 'Esri, Maxar, Earthstar Geographics, and the GIS User Community' });
var darkImagery = new Cesium.UrlTemplateImageryProvider({ url: 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', subdomains: 'abcd', credit: 'OpenStreetMap contributors CARTO' });
var viewer = new Cesium.Viewer('cesiumContainer', { imageryProvider: esriImagery, terrainProvider: new Cesium.EllipsoidTerrainProvider(), baseLayerPicker: false, geocoder: false, homeButton: false, sceneModePicker: false, navigationHelpButton: false, infoBox: false, selectionIndicator: false, fullscreenButton: false, animation: false, timeline: false, shouldAnimate: true });
viewer.scene.globe.showGroundAtmosphere = true;
viewer.scene.globe.enableLighting = true;
viewer.scene.backgroundColor = Cesium.Color.BLACK;
viewer.camera.setView({ destination: Cesium.Cartesian3.fromDegrees(-102.5, 23.6, 6500000) });
function glowTexture(color) {
  var c = document.createElement('canvas'); c.width = 64; c.height = 64; var ctx = c.getContext('2d');
  var g = ctx.createRadialGradient(32, 32, 2, 32, 32, 32); g.addColorStop(0, color); g.addColorStop(0.35, color); g.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.fillStyle = g; ctx.fillRect(0, 0, 64, 64); return c.toDataURL();
}
var arcs = [];
function addFleet() {
  viewer.entities.removeAll(); arcs = [];
  FLEET.forEach(function(u) {
    var col = u.on ? '#00FF88' : '#9CA3AF';
    viewer.entities.add({ position: Cesium.Cartesian3.fromDegrees(u.lon, u.lat), billboard: { image: glowTexture(u.on ? 'rgba(0,255,136,0.9)' : 'rgba(160,160,170,0.35)'), scale: 0.55, heightReference: Cesium.HeightReference.CLAMP_TO_GROUND, disableDepthTestDistance: Number.POSITIVE_INFINITY } });
    viewer.entities.add({ position: Cesium.Cartesian3.fromDegrees(u.lon, u.lat), point: { pixelSize: u.on ? 12 : 9, color: Cesium.Color.fromCssColorString(col), outlineColor: Cesium.Color.BLACK, outlineWidth: 2, heightReference: Cesium.HeightReference.CLAMP_TO_GROUND, disableDepthTestDistance: Number.POSITIVE_INFINITY }, properties: { id: u.id } });
    var start = Cesium.Cartesian3.fromDegrees(CFG.hubLon, CFG.hubLat);
    var end = Cesium.Cartesian3.fromDegrees(u.lon, u.lat);
    var pts = []; for (var i = 0; i <= 40; i++) { var t = i / 40; var p = Cesium.Cartesian3.lerp(start, end, t, new Cesium.Cartesian3()); var h = Math.sin(Math.PI * t) * 380000; var cart = Cesium.Cartographic.fromCartesian(p); pts.push(Cesium.Cartesian3.fromRadians(cart.longitude, cart.latitude, h)); }
    var arc = viewer.entities.add({ polyline: { positions: pts, width: 1.4, material: new Cesium.PolylineGlowMaterialProperty({ glowPower: 0.25, color: Cesium.Color.fromCssColorString(u.on ? '#00FF88' : '#22D3EE').withAlpha(0.45) }) } });
    arcs.push(arc);
  });
}
function renderList(filter) {
  filter = filter || '';
  var listEl = document.getElementById('list'); listEl.innerHTML = '';
  var onCount = 0; FLEET.forEach(function(u) { if (u.on) onCount++; });
  document.getElementById('kpi-total').textContent = String(FLEET.length);
  document.getElementById('kpi-online').textContent = String(onCount) + ' EN LINEA';
  document.getElementById('kpi-online-2').textContent = String(onCount);
  document.getElementById('kpi-offline').textContent = String(FLEET.length - onCount);
  document.getElementById('hudCount').textContent = String(FLEET.length);
  FLEET.filter(function(u) { return (u.id + ' ' + u.city).toLowerCase().indexOf(filter.toLowerCase()) !== -1; }).forEach(function(u) {
    var d = document.createElement('div'); d.className = 'item' + (u.on ? ' active' : '');
    d.innerHTML = '<div class="item-top"><b>' + u.id + '</b><span class="badge ' + (u.on ? 'on' : 'off') + '">' + (u.on ? 'EN LINEA' : 'FUERA') + '</span></div><small>' + u.city + ' - ' + u.lat.toFixed(4) + ', ' + u.lon.toFixed(4) + '</small>';
    d.onclick = function() { viewer.camera.flyTo({ destination: Cesium.Cartesian3.fromDegrees(u.lon, u.lat, 450000), duration: 1.2 }); };
    listEl.appendChild(d);
  });
}
async function loadPositions() {
  try {
    var res = await fetch(CFG.apiPositions);
    var data = await res.json();
    var arr = Array.isArray(data) ? data : (data.positions || data.devices || []);
    if (!arr || arr.length === 0) throw new Error('sin datos');
    FLEET = arr.map(function(p) {
      var lat = Number(p.lat || p.latitude || p.Latitud);
      var lon = Number(p.lon || p.lng || p.longitude || p.Longitud);
      var id = p.dispositivo_id || p.mid || p.deviceId || p.id || 'SIN-ID';
      var on = (p.online === true) || (p.en_linea === true) || (p.status === 'online') || (String(p.estado || '').toLowerCase() === 'en linea');
      return { id: id, lat: lat, lon: lon, on: on, city: p.ciudad || p.city || '' };
    }).filter(function(u) { return !isNaN(u.lat) && !isNaN(u.lon); });
    document.getElementById('api-status').textContent = 'EN VIVO';
    document.getElementById('api-status').style.color = '#00FF88';
  } catch (e) {
    if (FLEET.length === 0) FLEET = DEMO.slice();
    document.getElementById('api-status').textContent = 'DEMO - SIN BACKEND';
    document.getElementById('api-status').style.color = '#F59E0B';
  }
  addFleet(); renderList(document.getElementById('q').value);
}
document.getElementById('q').addEventListener('input', function(e) { renderList(e.target.value); });
var b3d = document.getElementById('b3d'), b2d = document.getElementById('b2d'), bMap = document.getElementById('bMap'), bSat = document.getElementById('bSat'), bArcs = document.getElementById('bArcs');
b3d.onclick = function() { viewer.scene.morphTo3D(1.0); b3d.classList.add('active'); b2d.classList.remove('active'); };
b2d.onclick = function() { viewer.scene.morphTo2D(1.0); b2d.classList.add('active'); b3d.classList.remove('active'); };
bMap.onclick = function() { viewer.imageryLayers.removeAll(); viewer.imageryLayers.addImageryProvider(darkImagery); bMap.classList.add('active'); bSat.classList.remove('active'); };
bSat.onclick = function() { viewer.imageryLayers.removeAll(); viewer.imageryLayers.addImageryProvider(esriImagery); bSat.classList.add('active'); bMap.classList.remove('active'); };
var arcsOn = true; bArcs.onclick = function() { arcsOn = !arcsOn; arcs.forEach(function(a) { a.show = arcsOn; }); bArcs.textContent = arcsOn ? 'ARCOS ON' : 'ARCOS OFF'; };
setInterval(function() { document.getElementById('zulu').textContent = new Date().toISOString().slice(11, 19) + 'Z'; }, 1000);
var handler = new Cesium.ScreenSpaceEventHandler(viewer.scene.canvas);
handler.setInputAction(function(m) { var cart = viewer.camera.pickEllipsoid(m.endPosition, viewer.scene.globe.ellipsoid); if (cart) { var c = Cesium.Cartographic.fromCartesian(cart); document.getElementById('cursor').textContent = 'CURSOR ' + Cesium.Math.toDegrees(c.latitude).toFixed(4) + ' - ' + Cesium.Math.toDegrees(c.longitude).toFixed(4); } }, Cesium.ScreenSpaceEventType.MOUSE_MOVE);
function connectWS() {
  try {
    var proto = (location.protocol === 'https:') ? 'wss:' : 'ws:';
    var ws = new WebSocket(proto + '//' + location.host + CFG.wsPath);
    ws.onmessage = function(ev) { try { var msg = JSON.parse(ev.data); if (msg.type === 'telemetria' || msg.type === 'geofence') loadPositions(); } catch (e) {} };
    ws.onclose = function() { setTimeout(connectWS, 2000); };
  } catch (e) {}
}
document.getElementById('btn-usgs-quakes').addEventListener('click', async function() {
  try {
    var res = await fetch(CFG.usgsUrl); var data = await res.json();
    alert('Sismos USGS ultimas 24h: ' + data.features.length + ' eventos. Activa la capa en fleet.html para verlos en mapa.');
  } catch (e) { alert('Error USGS'); }
});
loadPositions();
setInterval(loadPositions, CFG.refreshMs);
connectWS();
</script>
</body>
</html>





